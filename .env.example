# Settings for Docker Compose, which reads this file as .env.
# The relaybox binary reads environment variables only; it does not load .env.
# docs/configuration.md describes every variable. Never commit .env.

# Required for Docker Compose. At least 24 characters, no spaces.
# Generate one with: openssl rand -base64 32
RELAYBOX_DASHBOARD_TOKEN=

# Host port, published on 127.0.0.1 only.
# RELAYBOX_HOST_PORT=8787

# Base URL shown in endpoint URLs, for example a tunnel address.
# RELAYBOX_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Compose always runs the dashboard in remote mode, where replay to URLs is
# off. Set to true to allow replay to public addresses. Private, loopback,
# and cloud metadata addresses stay blocked either way.
# RELAYBOX_ALLOW_REMOTE_REPLAY=false

# Storage and retention
# RELAYBOX_MAX_BODY_BYTES=1048576
# RELAYBOX_RETENTION_DAYS=7
# RELAYBOX_MAX_STORED_REQUESTS=10000

# Logging: level debug, info, warn, or error; format text or json
# RELAYBOX_LOG_LEVEL=info
# RELAYBOX_LOG_FORMAT=text

# Capture rate limit per endpoint. A rate of 0 disables it.
# RELAYBOX_RATE_LIMIT_RPS=50
# RELAYBOX_RATE_LIMIT_BURST=100
