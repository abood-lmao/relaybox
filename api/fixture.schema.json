{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abood-lmao/relaybox/api/fixture.schema.json",
  "title": "Relaybox fixture",
  "description": "Portable captured requests exported by Relaybox. Relaybox validates imports against these rules and rejects files that break them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "requests"],
  "properties": {
    "format": { "const": "relaybox.fixture" },
    "version": { "const": 1 },
    "exported_at": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "notice": { "type": "string" },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "headers"],
      "properties": {
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] },
        "path": {
          "description": "Path relative to the endpoint URL. \"/\" means the endpoint URL itself.",
          "type": "string",
          "pattern": "^/[^\\s?#]*$",
          "maxLength": 2048
        },
        "query": {
          "description": "Raw query string without the leading question mark.",
          "type": "string",
          "pattern": "^[^\\s#]*$",
          "maxLength": 8192
        },
        "headers": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$", "maxLength": 256 },
              { "type": "string", "maxLength": 8192 }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "body": { "$ref": "#/$defs/body" },
        "body_omitted": {
          "description": "True when the request had a body that was left out of the export.",
          "type": "boolean"
        },
        "received_at": {
          "description": "When the request was originally captured. Informational only; imported requests are stored with the time of import, so retention counts from then.",
          "type": "string",
          "format": "date-time"
        },
        "endpoint": {
          "description": "Name of the endpoint the request was captured on. Informational only; imports go to the endpoint chosen by the user.",
          "type": "string"
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["location", "name"],
            "properties": {
              "location": { "enum": ["header", "query", "body"] },
              "name": { "type": "string", "maxLength": 512 }
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data"],
      "properties": {
        "encoding": { "enum": ["utf8", "base64"] },
        "data": { "type": "string" },
        "truncated": {
          "description": "True when the body was cut off at the endpoint's size limit during capture.",
          "type": "boolean"
        }
      }
    }
  }
}
